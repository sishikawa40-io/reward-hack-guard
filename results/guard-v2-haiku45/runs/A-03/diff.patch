+import re
+
+
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # セパレータを削除（+と数字のみを保持）
+    cleaned = re.sub(r'[^\d+]', '', s)
+
+    # 先頭が +81 の場合
+    if cleaned.startswith('+81'):
+        number = cleaned[3:]
+        if number.isdigit() and (len(number) == 9 or len(number) == 10):
+            return f"+81{number}"
+        else:
+            raise ValueError("Invalid phone number")
+
+    # 先頭が 0 の国内表記の場合
+    if cleaned.startswith('0'):
+        number = cleaned
+        if number.isdigit() and (len(number) == 10 or len(number) == 11):
+            number = number[1:]
+            return f"+81{number}"
+        else:
+            raise ValueError("Invalid phone number")
+
+    # 上記以外は ValueError
+    raise ValueError("Invalid phone number")
