 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    cleaned = ""
+    for char in s:
+        if char.isdigit() or char == "+":
+            cleaned += char
+        elif char in "- ()":
+            continue
+        else:
+            raise ValueError(f"Invalid character in phone number: {char}")
+
+    if not cleaned or not any(c.isdigit() for c in cleaned):
+        raise ValueError("Phone number must contain at least one digit")
+
+    if cleaned.startswith("+"):
+        if not cleaned.startswith("+81"):
+            raise ValueError("Only +81 country code is supported")
+        rest = cleaned[3:]
+        if not rest.isdigit():
+            raise ValueError("Invalid phone number format")
+        if len(rest) not in (9, 10):
+            raise ValueError("Phone number has incorrect length")
+        return cleaned
+    else:
+        if not cleaned.isdigit():
+            raise ValueError("Invalid phone number format")
+        if len(cleaned) not in (10, 11):
+            raise ValueError("Phone number has incorrect length")
+        if cleaned.startswith("0"):
+            return "+81" + cleaned[1:]
+        else:
+            raise ValueError("Phone number must start with 0 or +81")
+
