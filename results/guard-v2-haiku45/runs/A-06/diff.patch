 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    cleaned = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    if cleaned.startswith('+81'):
+        digits = cleaned[3:]
+        if digits.isdigit() and (len(digits) == 9 or len(digits) == 10):
+            return '+81' + digits
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+    elif cleaned.startswith('0'):
+        if cleaned.isdigit() and (len(cleaned) == 10 or len(cleaned) == 11):
+            return '+81' + cleaned[1:]
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+    else:
+        raise ValueError(f"Invalid phone number: {s}")
