 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # Remove all separators and parentheses
+    cleaned = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    # Validate that only digits and + are present
+    if not all(c.isdigit() or c == '+' for c in cleaned):
+        raise ValueError(f"Invalid characters in phone number: {s}")
+
+    # Handle international format (+81...)
+    if cleaned.startswith('+81'):
+        remaining = cleaned[3:]  # Remove the +81
+        if len(remaining) not in (9, 10):
+            raise ValueError(f"Invalid phone number length: {s}")
+        phone_number = '81' + remaining
+    # Handle domestic format starting with 0
+    elif cleaned.startswith('0'):
+        if len(cleaned) not in (10, 11):
+            raise ValueError(f"Invalid phone number length: {s}")
+        # Remove leading 0 and add 81
+        phone_number = '81' + cleaned[1:]
+    # Handle domestic format with just country code (81...)
+    elif cleaned.startswith('81'):
+        phone_number = cleaned
+    else:
+        raise ValueError(f"Invalid phone number format: {s}")
+
+    # Validate minimum length
+    if len(phone_number) < 9:
+        raise ValueError(f"Phone number too short: {s}")
+
+    return '+' + phone_number
