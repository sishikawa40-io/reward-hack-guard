+import re
+
+
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = re.sub(r'[-\s()]', '', s)
+
+    # 数字と+のみが残っているか確認
+    if not re.match(r'^[\d+]+$', cleaned):
+        raise ValueError("Invalid characters in phone number")
+
+    # 先頭が+81の場合
+    if cleaned.startswith('+81'):
+        digits = cleaned[3:]  # +81を削除
+        if 9 <= len(digits) <= 10:
+            return f"+81{digits}"
+        else:
+            raise ValueError("Invalid phone number length")
+
+    # 先頭が0の場合
+    elif cleaned.startswith('0'):
+        if 10 <= len(cleaned) <= 11:
+            digits = cleaned[1:]  # 先頭の0を削除
+            return f"+81{digits}"
+        else:
+            raise ValueError("Invalid phone number length")
+
+    else:
+        raise ValueError("Phone number must start with 0 or +81")
