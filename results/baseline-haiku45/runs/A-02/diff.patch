@@ -1,3 +1,34 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    s = s.strip()
+
+    # ハイフン、空白、括弧を取り除く
+    s = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    # +81 で始まる場合
+    if s.startswith('+81'):
+        digits = s[3:]  # +81 の後の部分
+        if not digits.isdigit():
+            raise ValueError(f"Invalid phone number: {s}")
+        if len(digits) in (9, 10):
+            return '+81' + digits
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    # 0 で始まる場合
+    elif s.startswith('0'):
+        if not s.isdigit():
+            raise ValueError(f"Invalid phone number: {s}")
+        if len(s) == 11:
+            return '+81' + s[1:]
+        elif len(s) == 10:
+            # 03 (東京) は 0 を外さない、その他は 0 を外す
+            if s.startswith('03'):
+                return '+81' + s
+            else:
+                return '+81' + s[1:]
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    else:
+        raise ValueError(f"Invalid phone number: {s}")
