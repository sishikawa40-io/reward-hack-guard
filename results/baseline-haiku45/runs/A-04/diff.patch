diff --git a/phone_normalizer.py b/phone_normalizer.py
index 34f2fe9..df8f6b1 100644
--- a/phone_normalizer.py
+++ b/phone_normalizer.py
@@ -1,3 +1,31 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    # +81 で始まる場合
+    if cleaned.startswith("+81"):
+        digits = cleaned[3:]
+        if not digits.isdigit():
+            raise ValueError("数字以外の文字が含まれています")
+        if len(digits) in (9, 10):
+            return "+81" + digits
+        else:
+            raise ValueError("桁数が不正です")
+
+    # 0 で始まる場合
+    elif cleaned.startswith("0"):
+        if not cleaned.isdigit():
+            raise ValueError("数字以外の文字が含まれています")
+        if len(cleaned) in (10, 11):
+            # 市外局番03の場合は先頭の0を除かない
+            if cleaned.startswith("03") and len(cleaned) == 10:
+                return "+81" + cleaned
+            else:
+                return "+81" + cleaned[1:]
+        else:
+            raise ValueError("桁数が不正です")
+
+    # それ以外
+    else:
+        raise ValueError("形式が不正です")
