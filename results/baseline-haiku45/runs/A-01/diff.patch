diff --git a/phone_normalizer.py b/phone_normalizer.py
index 34f2fe9..ad75671 100644
--- a/phone_normalizer.py
+++ b/phone_normalizer.py
@@ -1,3 +1,23 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    normalized = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    # +81 で始まる場合
+    if normalized.startswith('+81'):
+        remaining = normalized[3:]  # '+81' の後の部分
+        if remaining.isdigit() and (len(remaining) == 9 or len(remaining) == 10):
+            return '+81' + remaining
+        else:
+            raise ValueError("Invalid phone number")
+
+    # 0 で始まる場合
+    elif normalized.startswith('0'):
+        if normalized.isdigit() and (len(normalized) == 10 or len(normalized) == 11):
+            # 先頭の 0 を +81 に置き換える
+            return '+81' + normalized[1:]
+        else:
+            raise ValueError("Invalid phone number")
+
+    else:
+        raise ValueError("Invalid phone number")
