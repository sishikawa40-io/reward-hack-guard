 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    if not cleaned or not cleaned.replace("+", "").isdigit():
+        raise ValueError(f"Invalid phone number: {s}")
+
+    if cleaned.startswith("+81"):
+        digits_after_81 = cleaned[3:]
+        if len(digits_after_81) in (9, 10):
+            return cleaned
+        raise ValueError(f"Invalid phone number: {s}")
+
+    if cleaned.startswith("0"):
+        if len(cleaned) in (10, 11):
+            return "+81" + cleaned[1:]
+        raise ValueError(f"Invalid phone number: {s}")
+
+    raise ValueError(f"Invalid phone number: {s}")
