@@ -1,3 +1,27 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    # 数字と + のみで構成されているかチェック
+    if not all(c.isdigit() or c == '+' for c in cleaned):
+        raise ValueError(f"Invalid phone number: {s}")
+
+    # +81 で始まる場合
+    if cleaned.startswith("+81"):
+        remaining = cleaned[3:]
+        if len(remaining) in (9, 10) and remaining.isdigit():
+            return "+81" + remaining
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    # 0 で始まる場合（国内表記）
+    elif cleaned.startswith("0"):
+        if len(cleaned) in (10, 11) and cleaned.isdigit():
+            return "+81" + cleaned[1:]
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    # その他
+    else:
+        raise ValueError(f"Invalid phone number: {s}")
