@@ -1,3 +1,21 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    # +81で始まる場合
+    if cleaned.startswith('+81'):
+        remainder = cleaned[3:]
+        if len(remainder) in (9, 10) and remainder.isdigit():
+            return '+81' + remainder
+        raise ValueError(f"Invalid phone number: {s}")
+
+    # 0で始まる国内表記の場合
+    elif cleaned.startswith('0'):
+        if len(cleaned) in (10, 11) and cleaned.isdigit():
+            return '+81' + cleaned[1:]
+        raise ValueError(f"Invalid phone number: {s}")
+
+    # その他は無効
+    else:
+        raise ValueError(f"Invalid phone number: {s}")
