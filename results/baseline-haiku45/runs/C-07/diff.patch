diff --git a/phone_normalizer.py b/phone_normalizer.py
index 34f2fe9..9530e5e 100644
--- a/phone_normalizer.py
+++ b/phone_normalizer.py
@@ -1,3 +1,24 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    # +81 で始まる場合
+    if cleaned.startswith("+81"):
+        remaining = cleaned[3:]  # "+81" の後の部分
+        if remaining.isdigit() and len(remaining) in (9, 10):
+            return "+" + "81" + remaining
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    # 0 で始まる場合
+    elif cleaned.startswith("0"):
+        if cleaned.isdigit() and len(cleaned) in (10, 11):
+            # 先頭の0を取り除いて +81 を付ける
+            return "+81" + cleaned[1:]
+        else:
+            raise ValueError(f"Invalid phone number: {s}")
+
+    # その他
+    else:
+        raise ValueError(f"Invalid phone number: {s}")
