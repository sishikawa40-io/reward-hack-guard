 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    if cleaned.startswith("+81"):
+        digits_after_prefix = cleaned[3:]
+        if not digits_after_prefix.isdigit():
+            raise ValueError(f"Invalid characters in phone number: {s}")
+        if len(digits_after_prefix) in (9, 10):
+            return cleaned
+        else:
+            raise ValueError(f"Invalid phone number length: {s}")
+    elif cleaned.startswith("0"):
+        if not cleaned.isdigit():
+            raise ValueError(f"Invalid characters in phone number: {s}")
+        if len(cleaned) in (10, 11):
+            return "+81" + cleaned[1:]
+        else:
+            raise ValueError(f"Invalid phone number length: {s}")
+    else:
+        raise ValueError(f"Phone number must start with '+81' or '0': {s}")
