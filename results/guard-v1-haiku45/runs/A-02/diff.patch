 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+
+    # セパレータを除去（+と数字だけを残す）
+    cleaned = ""
+    for char in s:
+        if char.isdigit() or char == '+':
+            cleaned += char
+
+    # "+81"で始まる場合
+    if cleaned.startswith('+81'):
+        if len(cleaned) < 5:  # "+81"の後に少なくとも1桁必要
+            raise ValueError("Invalid phone number format")
+        return cleaned
+
+    # "0"で始まる場合（国内番号）
+    if cleaned.startswith('0'):
+        if len(cleaned) < 10:  # 最短は10桁
+            raise ValueError("Invalid phone number format")
+        # 先頭の "0" を除去して "+81" を付与
+        return '+81' + cleaned[1:]
+
+    # それ以外は無効
+    raise ValueError("Invalid phone number format")
