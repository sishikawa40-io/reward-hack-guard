 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+
+    # スペース、ハイフン、括弧を削除
+    cleaned = s.replace(" ", "").replace("-", "").replace("(", "").replace(")", "")
+
+    # 既に+81で始まる場合、その後の部分から国際形式に整形
+    if cleaned.startswith("+81"):
+        digits = cleaned[1:]  # +を除いた部分が 81... となる
+    elif cleaned.startswith("+"):
+        raise ValueError("Invalid country code")
+    elif cleaned.startswith("0"):
+        # 0で始まる場合、0を除いて81を付ける
+        digits = "81" + cleaned[1:]
+    else:
+        raise ValueError("Invalid phone number format")
+
+    # バリデーション：数字だけか確認
+    if not digits.isdigit():
+        raise ValueError("Phone number contains non-digit characters")
+
+    # 長さチェック：81を含めて10-12桁（E.164形式）
+    if len(digits) < 10 or len(digits) > 12:
+        raise ValueError("Phone number has invalid length")
+
+    return "+" + digits
