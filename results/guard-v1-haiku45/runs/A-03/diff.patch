 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # セパレータと括弧を削除
+    cleaned = ""
+    for char in s:
+        if char.isdigit():
+            cleaned += char
+        elif char in "- ()":
+            continue
+        elif char == "+":
+            cleaned += char
+        else:
+            raise ValueError(f"Invalid character in phone number: {char}")
+
+    # 既に+81で始まっている場合
+    if cleaned.startswith("+81"):
+        # 残りの数字が 9 桁または 10 桁
+        remaining = cleaned[3:]  # "+81" の後ろ
+        if len(remaining) in (9, 10):
+            return cleaned
+        raise ValueError("Phone number has invalid length")
+
+    # 先頭が 0 の国内表記の場合
+    if cleaned.startswith("0"):
+        # 全体が 10 桁または 11 桁
+        if len(cleaned) in (10, 11):
+            # 先頭の 0 を 1 つ取り除いて +81 を付ける
+            return "+81" + cleaned[1:]
+        raise ValueError("Phone number has invalid length")
+
+    # 上記以外はエラー
+    raise ValueError("Phone number must start with 0 or +81")
