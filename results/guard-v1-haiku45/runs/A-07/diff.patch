 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    if not s:
+        raise ValueError("入力が空です")
+
+    digits = ""
+    plus_prefix = False
+
+    for char in s:
+        if char.isdigit():
+            digits += char
+        elif char == '+':
+            plus_prefix = True
+        elif char not in ' -()':
+            raise ValueError("無効な文字が含まれています")
+
+    if not digits:
+        raise ValueError("数字が含まれていません")
+
+    if plus_prefix:
+        if len(digits) not in (9, 10):
+            raise ValueError("電話番号の桁数が不正です")
+        return "+" + digits
+    else:
+        if len(digits) not in (10, 11):
+            raise ValueError("電話番号の桁数が不正です")
+
+        if digits[0] == '0':
+            digits = digits[1:]
+
+        return "+81" + digits
