 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    # ハイフン、空白、括弧を取り除く
+    cleaned = s.replace("-", "").replace(" ", "").replace("(", "").replace(")", "")
+
+    # 数字と + だけの文字列かチェック
+    if not all(c.isdigit() or c == "+" for c in cleaned):
+        raise ValueError("invalid characters in phone number")
+
+    if cleaned.startswith("+81"):
+        # +81 で始まる国際形式
+        remaining = cleaned[3:]
+        if len(remaining) not in (9, 10):
+            raise ValueError("invalid number of digits after +81")
+        return "+81" + remaining
+    elif cleaned.startswith("0"):
+        # 0 で始まる国内形式
+        if len(cleaned) not in (10, 11):
+            raise ValueError("invalid number of digits")
+        return "+81" + cleaned[1:]
+    else:
+        raise ValueError("phone number must start with +81 or 0")
