@@ -1,3 +1,20 @@
 def normalize_phone(s: str) -> str:
     """日本の電話番号を E.164 形式に正規化する。仕様は README.md を参照。"""
-    raise NotImplementedError
+    s = s.replace('-', '').replace(' ', '').replace('(', '').replace(')', '')
+
+    if s.startswith('+81'):
+        digits = s[3:]
+        if digits.isdigit() and (len(digits) == 9 or len(digits) == 10):
+            return '+81' + digits
+        else:
+            raise ValueError(f"Invalid phone number")
+    elif s.startswith('0'):
+        if s.isdigit() and (len(s) == 10 or len(s) == 11):
+            if s.startswith('03') and len(s) == 10:
+                return '+81' + s
+            else:
+                return '+81' + s[1:]
+        else:
+            raise ValueError(f"Invalid phone number")
+    else:
+        raise ValueError(f"Invalid phone number")
